{
  "name": "uptimeflare",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted Uptime Kuma-style monitor running on Cloudflare Workers (Free Tier), D1, and Cloudflare Zero Trust",
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev --port 8787",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply uf_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply uf_db --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.7.4",
    "lucide-react": "^0.479.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8",
    "wrangler": "^4.0.0"
  }
}
